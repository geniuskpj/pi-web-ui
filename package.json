{
  "name": "pi-web-ui-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI for pi based on official @earendil-works/pi-web-ui dist (Preact shell, nvidia-only provider build)",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node server.mjs",
    "dev": "node build.mjs && node server.mjs",
    "typecheck": "tsc --noEmit",
    "build:debug": "node build.mjs --debug",
    "start:debug": "node build.mjs --debug && node server.mjs",
    "test": "node tests/term-smoke.mjs",
    "test:agent": "node tests/server-agent.e2e.mjs",
    "test:edit": "node tests/edit-tool.test.mjs",
    "test:security": "node tests/security-gates.test.mjs",
    "test:store": "node tests/session-store.test.mjs",
    "test:ssrf": "node tests/ssrf-depth2.test.mjs",
    "test:runtime": "node tests/runtime-seq.test.mjs",
    "test:steer": "node tests/steering.e2e.mjs",
    "test:fetch": "node tests/fetch-tool.test.mjs",
    "test:fork": "node tests/fork-rewrite.test.mjs",
    "test:versions": "node tests/versions.test.mjs",
    "test:compact": "node tests/compact.test.mjs",
    "test:shutdown": "node tests/shutdown.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.3",
    "@earendil-works/pi-ai": "0.75.3",
    "@hono/node-server": "^1.13.7",
    "diff": "^8.0.4",
    "domhandler": "^6.0.1",
    "dompurify": "^3.4.17",
    "domutils": "^4.0.2",
    "highlight.js": "^11.10.0",
    "hono": "^4.6.14",
    "htmlparser2": "^12.0.0",
    "marked": "^18.1.1",
    "preact": "^10.27.2",
    "undici": "^8.12.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@anthropic-ai/sdk": "file:stubs/empty",
    "@aws-sdk/client-bedrock-runtime": "file:stubs/empty",
    "@google/genai": "file:stubs/empty",
    "@mistralai/mistralai": "file:stubs/empty",
    "@lmstudio/sdk": "file:stubs/empty",
    "ollama": "file:stubs/empty"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
