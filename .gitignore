# --- dependencies -------------------------------------------------------------
node_modules/

# --- build output (regenerated by `npm run build` / `npm run dev`) ------------
# esbuild writes content-hashed bundles + manifest.json here; build.mjs prunes
# stale hashed files on every run.
# EXCEPTION: public/assets/app.css is a VENDORED static copy of the old
# @earendil-works/pi-web-ui theme (tailwind + theme variables). It is NOT
# regenerable once that package is removed — build.mjs throws without it —
# so it stays tracked while the rest of assets/ is ignored.
public/assets/*
!public/assets/app.css

# precompression siblings generated by build.mjs (*.br / *.gz next to sources)
*.br
*.gz

# --- vendored terminal renderer (TRACKED on purpose) --------------------------
# public/vendor/wterm/ is the prebuilt @wterm/dist bundle (~150KB, pinned
# @wterm 0.5.4). build.mjs FAILS without it and no npm script runs
# vendor-wterm.mjs first, so a fresh clone needs it in git to build offline
# (self-contained / no-CDN philosophy). Regenerate after a version bump:
#   node vendor-wterm.mjs

# --- runtime data (NEVER commit) ----------------------------------------------
# data/ holds private chat transcripts (sessions/*.jsonl), the auto-generated
# API token (auth-token.txt), the downloaded msys2 script.exe pty bridge
# (bin/script/), the generated term-shell rc/cmd, and the staged extension
# loader (ext-loader/). All of it is created/regenerated at runtime.
data/

# --- logs ---------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- credentials / secrets ----------------------------------------------------
.env
.env.*
.env.local
.npmrc
auth.json
auth-token.txt   # normally inside data/, but PI_WEB_DATA_DIR can move it
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials*.json
# pi config dir can appear nested; it holds auth.json (provider API keys)
.pi/

# --- temp files ---------------------------------------------------------------
*.tmp
*.orig
*~

# --- editor / OS junk ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
